{
  "name": "trestle-govcon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env.test.local node_modules/@playwright/test/cli.js test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:migration:new": "supabase migration new",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-db.mjs",
    "db:provision-runtime": "node --env-file-if-exists=.env.local scripts/provision-runtime.mjs",
    "staff:create": "node --env-file-if-exists=.env.local scripts/create-staff.mjs",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/reset-demo.mjs",
    "test:db": "node --conditions=react-server --env-file-if-exists=.env.test.local --import tsx scripts/test-database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.23",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "npm@10.9.2"
}
