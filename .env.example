# Normal app startup: hosted Supabase URL + publishable/anon key.
# Copy to .env.local and fill in your project values. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SITE_URL=http://localhost:3000

# Optional administrative Auth setup for staff/demo scripts, never used by app requests.
SUPABASE_SECRET_KEY=
DEMO_EMAIL=
DEMO_PASSWORD=

# Hosted integration/browser tests use a dedicated TEST project in .env.test.local.
ALLOW_DATABASE_TESTS=false

# Optional CLI migration path only. Not required for app startup or SQL Editor setup.
# DATABASE_ADMIN_URL=
