# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Supabase > Project Settings > Database).
# Used by Drizzle (server + ingestion scripts only).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project (Auth). The publishable/anon key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SAM.gov public API key (https://sam.gov > Account Details). Server/scripts only.
SAM_API_KEY=
