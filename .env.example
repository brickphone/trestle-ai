# Hosted Supabase only. Copy to .env.local; never commit real values.
# Runtime role password is set by npm run db:provision-runtime.
# Pooler usernames can be app_runtime.<project-ref>. Use the project's connection settings.
DATABASE_URL=postgresql://app_runtime.PROJECT_REF:REPLACE_PASSWORD@HOST:6543/postgres
# Administrative connection for migrations/provisioning/tests ONLY. Never used by the app.
DATABASE_ADMIN_URL=postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@HOST:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase secret/service-role key for administrative scripts.
SUPABASE_SECRET_KEY=
SITE_URL=http://localhost:3000
# Dedicated demo credentials: server-only; create via npm run demo:reset.
DEMO_EMAIL=
DEMO_PASSWORD=
# Database/browser suites must point at a dedicated hosted TEST project.
ALLOW_DATABASE_TESTS=false
